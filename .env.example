PORT=3001
NODE_ENV=development
LOG_LEVEL=debug

DATABASE_URL=postgres://trust:trust@localhost:5433/trust
REDIS_URL=redis://localhost:6380

# Session cookies for the human dashboard. 32+ random bytes (base64).
TRUST_SESSION_SECRET=replace-me-with-a-long-random-string
TRUST_ADMIN_SECRET=replace-me-with-a-long-random-string

# AES-256-GCM key-encryption-key for signing-key private material at
# rest. Generate once: `openssl rand -base64 32`. MUST decode to
# exactly 32 bytes. Rotating is a controlled operation — see
# README.md "Rotating the KEK".
TRUST_KEK_BASE64=replace-me-with-openssl-rand-base64-32

# HMAC key for deriving §10.4 `sub_h` pairwise human pseudonyms.
# Generate once: `openssl rand -base64 32`. MUST decode to exactly
# 32 bytes. Distinct from TRUST_KEK_BASE64. Rotating invalidates
# every consuming service's per-`sub_h` dedup state — treat as
# incident response, not routine hygiene (§12.9).
TRUST_PSEUDONYM_KEY_BASE64=replace-me-with-openssl-rand-base64-32

# Public origin this instance serves (used for absolute URLs in deep
# links and for the canonical JWKS URL the AFAP-pinned hostname
# rewrites to).
PUBLIC_BASE_URL=http://localhost:3001

# AFAP-0006 pins the JWKS URL to
# https://trust.afauth.org/.well-known/jwks.json — this service
# serves it directly. The variable is here so the landing page can
# advertise the canonical URL even when PUBLIC_BASE_URL is localhost.
JWKS_PUBLIC_URL=http://localhost:3001/.well-known/jwks.json

# Email magic-link sender. In dev, leave provider=stdout to print the
# magic link to the server log instead of sending.
EMAIL_PROVIDER=stdout
EMAIL_FROM=no-reply@trust.afauth.org
# EMAIL_API_KEY=

# Google OAuth credentials. Both required to enable the "Continue with
# Google" sign-in button + the /account "Connect Google" card. Get them
# from Google Cloud Console → APIs & Services → Credentials → "OAuth
# 2.0 Client IDs". Register the redirect URI exactly as
# `{PUBLIC_BASE_URL}/auth/google/callback`. Leave both unset to disable.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
