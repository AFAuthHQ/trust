{
  "name": "@afauthhq/trust",
  "version": "0.1.0",
  "private": true,
  "description": "AFAuth trust attestor at trust.afauth.org — issues afauth-trust JWTs per AFAP-0006.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
